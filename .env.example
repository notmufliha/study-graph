# Built-in AI: the default for visitors, so they don't need to install or configure
# anything. The key stays on the server and is only ever sent to AI_BASE_URL.
# Leave AI_API_KEY empty to turn the built-in AI off (users can still choose
# Ollama on their own computer, or their own API key, in Settings).
AI_API_KEY=
# Any OpenAI-compatible API. Defaults to Groq (free tier: https://console.groq.com/keys).
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b
